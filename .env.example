# Server-only variables. Add them in Vercel Project Settings → Environment Variables.
# Never expose these values in browser code or commit a populated .env file.

# Required: Resend delivery
RESEND_API_KEY=
LEAD_NOTIFY_TO=hello@arvinify.com
LEAD_NOTIFY_FROM=Arvinify <hello@arvinify.com>
LEAD_REPLY_TO=hello@arvinify.com

# Public site
SITE_URL=https://www.arvinify.com

# AI Gateway. Vercel deployments can use automatic OIDC authentication.
# Set AI_GATEWAY_API_KEY for local/non-Vercel execution, or AI_DISABLED=true
# when deliberately testing the deterministic qualification fallback.
AI_MODEL=openai/gpt-6-astra-fast
AI_GATEWAY_API_KEY=
AI_DISABLED=false

# Optional: queue one Resend reminder for high-priority leads.
FOLLOW_UP_ENABLED=false
FOLLOW_UP_DELAY_DAYS=2

# Optional: forward the structured lead + qualification to Make, Zapier,
# HubSpot middleware, or another HTTPS CRM endpoint.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
