# Arvinify Website Rescue — lead intake (api/rescue.js)
#
# Set these in the Vercel project settings (Project → Settings → Environment
# Variables), NEVER in frontend code. The intake form returns a real failure
# until RESEND_API_KEY is set; it never fakes success.

# Resend API key. Create a free account at https://resend.com, then
# Dashboard → API Keys → Create. Copy the key (starts with "re_").
RESEND_API_KEY=

# Where lead emails are delivered. Defaults to hello@arvinify.com if unset.
LEAD_NOTIFY_TO=hello@arvinify.com

# The "From" address. For production, verify your domain in Resend
# (Dashboard → Domains) and use an address on it, e.g.
#   Arvinify Rescue <rescue@arvinify.com>
# For quick preview testing you can leave this unset — the code falls back to
# Resend's shared sender "onboarding@resend.dev", which can only deliver to
# the email address that owns your Resend account.
LEAD_NOTIFY_FROM=
